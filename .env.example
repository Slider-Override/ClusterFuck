# Copy to .env. Each Compose project starts ONE node with its own volume.
NODE_NAME=Standort-A
WEB_HOST_PORT=8443
IPERF_HOST_PORT=5201
WEB_INTERNAL_PORT=8443
IPERF_INTERNAL_PORT=5201
BIND_ADDRESS=0.0.0.0
TLS_ENABLED=true
ALLOW_INSECURE_PEERS=false
CLUSTERFUCK_IMAGE=ghcr.io/slider-override/clusterfuck:edge
